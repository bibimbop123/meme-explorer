<div class="profile-container">
  <div class="profile-header">
    <h1 class="profile-title">My Profile</h1>
  </div>
  <% if @history_cleared %>
    <p role="status" style="background: #d1e7dd; color: #0f5132; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">Your unseen meme browsing history has been reset.</p>
  <% end %>
  <% if @preferences_reset %>
    <p role="status" style="background: #d1e7dd; color: #0f5132; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">Your community feed preferences have been reset.</p>
  <% end %>
  
  <div style="background: #f9f9f9; padding: 15px; border-radius: 8px; margin-bottom: 30px;">
    <% if @user %>
      <p><strong>Username:</strong> <%= Rack::Utils.escape_html((@user["reddit_username"] || @user["email"] || "User").to_s) %></p>
      <p><strong>Email:</strong> <%= Rack::Utils.escape_html((@user["email"] || "Not provided").to_s) %></p>
      <p><strong>Member Since:</strong> <%= @user["created_at"] || "Unknown" %></p>
    <% end %>
    <hr>
    <p>📌 <strong><%= @saved_load_error ? 'Unavailable' : @saved_count %></strong> memes saved</p>
    <p>❤️ <strong><%= @liked_load_error ? 'Unavailable' : @liked_count %></strong> memes liked</p>
  </div>

  <!-- 🎬 CRITERION COLLECTION: Taste Profile -->
  <% if logged_in? %>
    <%= render_taste_profile(current_user_id) %>
  <% end %>

  <h2 id="liked-memes">My Liked Memes</h2>
  <form method="get" action="/profile#liked-memes" role="search" aria-label="Search liked memes" style="margin-bottom: 16px;">
    <label for="liked-query">Search likes by title or community</label>
    <input id="liked-query" name="liked_q" type="search" maxlength="200" value="<%= Rack::Utils.escape_html(@liked_query.to_s) %>">
    <input type="hidden" name="saved_page" value="<%= @saved_page %>">
    <% unless @saved_query.to_s.empty? %>
      <input type="hidden" name="saved_q" value="<%= Rack::Utils.escape_html(@saved_query) %>">
    <% end %>
    <button type="submit">Search likes</button>
    <% unless @liked_query.to_s.empty? %>
      <a href="/profile?saved_page=<%= @saved_page %><%= Rack::Utils.escape_html(@saved_query_suffix) %>#liked-memes">Clear likes search</a>
    <% end %>
  </form>
  <% if !@liked_load_error && !@liked_query.to_s.empty? %>
    <p role="status"><%= @liked_matches %> liked matches</p>
  <% end %>
  
  <% if @liked_load_error %>
    <p role="alert">We could not load your liked memes. Please try again.</p>
    <p><a href="/profile?saved_page=<%= @saved_page %>&amp;liked_page=<%= @liked_page %><%= Rack::Utils.escape_html(@saved_query_suffix) %><%= Rack::Utils.escape_html(@liked_query_suffix.to_s) %>#liked-memes">Try loading Likes again</a></p>
  <% elsif @liked_memes.empty? && !@liked_query.to_s.empty? %>
    <p>No liked memes match this search. Try another title or community, or clear the search.</p>
  <% elsif @liked_memes.empty? %>
    <p style="text-align: center; color: #999;">No liked memes yet.</p>
  <% else %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <% @liked_memes.each do |liked| %>
        <div style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden; cursor: pointer; transition: transform 0.2s;" >
          <% liked_href = liked['viewer_path'] || MediaUrl.safe(liked['meme_url']) || '/random' %>
          <a href="<%= Rack::Utils.escape_html(liked_href) %>" <%= 'target="_blank" rel="noopener"' unless liked['viewer_path'] %>><img src="<%= Rack::Utils.escape_html(MediaUrl.safe(liked['meme_url']) || '/images/meme-placeholder.svg') %>" alt="<%= Rack::Utils.escape_html((liked['meme_title'] || 'Liked meme').to_s) %>" style="width: 100%; height: 200px; object-fit: cover;"></a>
          <div style="padding: 10px;">
            <% if liked['meme_title'] %>
              <p style="margin: 0 0 4px 0; font-size: 0.9rem; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= Rack::Utils.escape_html(liked['meme_title'].to_s) %></p>
            <% end %>
            <% if liked['meme_subreddit'] %>
              <p style="margin: 0 0 4px 0; font-size: 0.8rem; color: #666;">r/<%= Rack::Utils.escape_html(liked['meme_subreddit'].to_s) %></p>
            <% end %>
            <p style="margin: 0 0 8px 0; font-size: 0.9rem; color: #666;">Liked: <%= liked['liked_at'] %></p>
            <form method="post" action="/profile/unlike" style="margin: 0;">
              <input type="hidden" name="authenticity_token" value="<%= Rack::Utils.escape_html(session['csrf'].to_s) %>">
              <input type="hidden" name="url" value="<%= Rack::Utils.escape_html(liked['meme_url'].to_s) %>">
              <input type="hidden" name="liked_page" value="<%= @liked_page %>">
              <input type="hidden" name="saved_page" value="<%= @saved_page %>">
              <button type="submit" style="padding: 4px 10px; font-size: 0.8rem; background: #f8f9fa; color: #dc3545; border: 1px solid #dc3545; border-radius: 4px; cursor: pointer;">Remove like</button>
            </form>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if !@liked_load_error && @liked_pages && @liked_pages > 1 %>
    <nav aria-label="Liked meme pages" style="display: flex; justify-content: center; gap: 24px; padding: 16px;">
      <% if @liked_page > 1 %>
        <a rel="prev" href="/profile?saved_page=<%= @saved_page %>&amp;liked_page=<%= @liked_page - 1 %><%= Rack::Utils.escape_html(@saved_query_suffix) %><%= Rack::Utils.escape_html(@liked_query_suffix.to_s) %>#liked-memes">← Previous likes</a>
      <% end %>
      <span>Likes page <%= @liked_page %> of <%= @liked_pages %></span>
      <% if @liked_page < @liked_pages %>
        <a rel="next" href="/profile?saved_page=<%= @saved_page %>&amp;liked_page=<%= @liked_page + 1 %><%= Rack::Utils.escape_html(@saved_query_suffix) %><%= Rack::Utils.escape_html(@liked_query_suffix.to_s) %>#liked-memes">More likes →</a>
      <% end %>
    </nav>
  <% end %>

  <h2 id="saved-memes">My Saved Memes</h2>
  <form method="get" action="/profile#saved-memes" role="search" aria-label="Search saved memes">
    <label for="saved-query">Search favorites by title or community</label>
    <input id="saved-query" name="saved_q" type="search" maxlength="200" value="<%= Rack::Utils.escape_html(@saved_query) %>">
    <input type="hidden" name="liked_page" value="<%= @liked_page %>">
    <% unless @liked_query.to_s.empty? %>
      <input type="hidden" name="liked_q" value="<%= Rack::Utils.escape_html(@liked_query) %>">
    <% end %>
    <button type="submit">Search saved</button>
    <% unless @saved_query.empty? %>
      <a href="/profile?liked_page=<%= @liked_page %><%= Rack::Utils.escape_html(@liked_query_suffix.to_s) %>#saved-memes">Clear search</a>
    <% end %>
  </form>
  <% if !@saved_load_error && !@saved_query.empty? %>
    <p role="status"><%= @saved_matches %> saved matches</p>
  <% end %>
  
  <% if @saved_load_error %>
    <p role="alert">We could not load your saved memes. This does not mean your favorites were removed.</p>
    <p><a href="/profile?saved_page=<%= @saved_page %><%= Rack::Utils.escape_html(@saved_query_suffix) %>#saved-memes">Try loading Saved again</a></p>
  <% elsif @saved_memes.empty? && !@saved_query.empty? %>
    <p>No saved memes match this search. Try another title or community, or clear the search.</p>
  <% elsif @saved_memes.empty? %>
    <p style="text-align: center;">No saved memes yet. Use Save while browsing to keep favorites in your account.</p>
    <p style="text-align: center;"><a href="/random">Find a meme to save</a></p>
  <% else %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px;">
      <% @saved_memes.each do |saved| %>
        <a id="saved-card-<%= saved['id'].to_i %>" href="/saved/<%= saved['id'].to_i %>?saved_page=<%= @saved_page %><%= Rack::Utils.escape_html(@saved_query_suffix) %>" style="display: block; color: inherit; text-decoration: none; border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
          <img src="<%= Rack::Utils.escape_html(MediaUrl.safe(saved["meme_url"]) || "/images/meme-placeholder.svg") %>" alt="<%= Rack::Utils.escape_html(saved["meme_title"].to_s) %>" style="width: 100%; height: 200px; object-fit: cover;">
          <div style="padding: 10px;">
            <p style="margin: 0; font-size: 0.9rem; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= Rack::Utils.escape_html(saved["meme_title"].to_s) %></p>
            <p style="margin: 5px 0 0 0; font-size: 0.8rem; color: #666;">r/<%= Rack::Utils.escape_html(saved["meme_subreddit"].to_s) %></p>
            <p style="margin: 5px 0 0 0; font-size: 0.75rem; color: #999;">Saved: <%= saved["saved_at"] %></p>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>

  <% if !@saved_load_error && @saved_pages && @saved_pages > 1 %>
    <nav aria-label="Saved meme pages" style="display: flex; justify-content: center; gap: 24px; padding: 16px;">
      <% if @saved_page > 1 %>
        <a rel="prev" href="/profile?liked_page=<%= @liked_page %>&amp;saved_page=<%= @saved_page - 1 %><%= Rack::Utils.escape_html(@saved_query_suffix) %><%= Rack::Utils.escape_html(@liked_query_suffix.to_s) %>#saved-memes">← Previous favorites</a>
      <% end %>
      <span>Page <%= @saved_page %> of <%= @saved_pages %></span>
      <% if @saved_page < @saved_pages %>
        <a rel="next" href="/profile?liked_page=<%= @liked_page %>&amp;saved_page=<%= @saved_page + 1 %><%= Rack::Utils.escape_html(@saved_query_suffix) %><%= Rack::Utils.escape_html(@liked_query_suffix.to_s) %>#saved-memes">More favorites →</a>
      <% end %>
    </nav>
  <% end %>

  <div style="margin-top: 30px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
    <a href="/random" style="padding: 10px 20px; background: #e52e71; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;">Browse Memes</a>
    <form method="post" action="/profile/clear-history" style="display: inline; margin: 0;">
      <input type="hidden" name="authenticity_token" value="<%= Rack::Utils.escape_html(session['csrf'].to_s) %>">
      <button type="submit" style="padding: 10px 16px; background: #eee; color: #333; border: 1px solid #ccc; border-radius: 4px; font-weight: 600; cursor: pointer;">Reset Unseen Feed History</button>
    </form>
    <a href="/profile/export.json" style="padding: 10px 16px; background: #eee; color: #333; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; font-weight: 600;">Export My Data (JSON)</a>
    <%= erb :'partials/_logout_form' %>
  </div>

  <details style="margin-top: 24px; padding: 14px; border: 1px solid #f5c2c7; border-radius: 8px; background: #fff8f8;">
    <summary style="cursor: pointer; font-weight: 600; color: #b02a37;">Privacy &amp; Account Deletion</summary>
    <p style="margin: 10px 0; font-size: 0.9rem; color: #444;">Permanently delete your account, saved favorites, liked memes, and preferences. Type <code>DELETE</code> to confirm.</p>
    <form method="post" action="/profile/delete-account" style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
      <input type="hidden" name="authenticity_token" value="<%= Rack::Utils.escape_html(session['csrf'].to_s) %>">
      <label for="confirm-delete-input" class="sr-only">Type DELETE to confirm account deletion</label>
      <input id="confirm-delete-input" type="text" name="confirm_delete" placeholder="Type DELETE" required pattern="DELETE" style="padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px;">
      <button type="submit" style="padding: 8px 14px; background: #dc3545; color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">Delete My Account</button>
    </form>
  </details>

  <!-- Ad improvement: this page had zero ad inventory before, despite
       real per-user content (liked/saved meme grids). Gated on combined
       liked+saved count against AdSense's minimum-content policy
       (should_show_ads_for_content? expects an Array, so pass a
       placeholder array of that combined size rather than a bare
       integer) - a brand-new account with nothing liked/saved yet
       shouldn't get an ad here, same reasoning as /search's empty state. -->
  <% if should_show_ads_for_content?(Array.new(@liked_memes.size + @saved_memes.size)) %>
    <%= render_hero_ad %>
  <% end %>
</div>
