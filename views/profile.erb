<div class="profile-container">
  <div class="profile-header">
    <h1 class="profile-title">My Profile</h1>
  </div>
  
  <div style="background: #f9f9f9; padding: 15px; border-radius: 8px; margin-bottom: 30px;">
    <% if @user %>
      <p><strong>Username:</strong> <%= Rack::Utils.escape_html((@user["reddit_username"] || @user["email"] || "User").to_s) %></p>
      <p><strong>Email:</strong> <%= Rack::Utils.escape_html((@user["email"] || "Not provided").to_s) %></p>
      <p><strong>Member Since:</strong> <%= @user["created_at"] || "Unknown" %></p>
    <% end %>
    <hr>
    <p>📌 <strong><%= @saved_load_error ? 'Unavailable' : @saved_count %></strong> memes saved</p>
    <p>❤️ <strong><%= @liked_load_error ? 'Unavailable' : @liked_count %></strong> memes liked</p>
  </div>

  <!-- 🎬 CRITERION COLLECTION: Taste Profile -->
  <% if logged_in? %>
    <%= render_taste_profile(current_user_id) %>
  <% end %>

  <h2 id="liked-memes">My Liked Memes</h2>
  
  <% if @liked_load_error %>
    <p role="alert">We could not load your liked memes. Please try again.</p>
    <p><a href="/profile?saved_page=<%= @saved_page %>&amp;liked_page=<%= @liked_page %><%= Rack::Utils.escape_html(@saved_query_suffix) %>#liked-memes">Try loading Likes again</a></p>
  <% elsif @liked_memes.empty? %>
    <p style="text-align: center; color: #999;">No liked memes yet.</p>
  <% else %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <% @liked_memes.each do |liked| %>
        <div style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden; cursor: pointer; transition: transform 0.2s;" >
          <a href="<%= Rack::Utils.escape_html(MediaUrl.safe(liked['meme_url']) || '/random') %>" target="_blank" rel="noopener"><img src="<%= Rack::Utils.escape_html(MediaUrl.safe(liked['meme_url']) || '/images/meme-placeholder.svg') %>" alt="Liked meme" style="width: 100%; height: 200px; object-fit: cover;"></a>
          <div style="padding: 10px;">
            <p style="margin: 0; font-size: 0.9rem; color: #666;">Liked: <%= liked['liked_at'] %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if !@liked_load_error && @liked_pages && @liked_pages > 1 %>
    <nav aria-label="Liked meme pages" style="display: flex; justify-content: center; gap: 24px; padding: 16px;">
      <% if @liked_page > 1 %>
        <a rel="prev" href="/profile?saved_page=<%= @saved_page %>&amp;liked_page=<%= @liked_page - 1 %><%= Rack::Utils.escape_html(@saved_query_suffix) %>#liked-memes">← Previous likes</a>
      <% end %>
      <span>Likes page <%= @liked_page %> of <%= @liked_pages %></span>
      <% if @liked_page < @liked_pages %>
        <a rel="next" href="/profile?saved_page=<%= @saved_page %>&amp;liked_page=<%= @liked_page + 1 %><%= Rack::Utils.escape_html(@saved_query_suffix) %>#liked-memes">More likes →</a>
      <% end %>
    </nav>
  <% end %>

  <h2 id="saved-memes">My Saved Memes</h2>
  <form method="get" action="/profile#saved-memes" role="search" aria-label="Search saved memes">
    <label for="saved-query">Search favorites by title or community</label>
    <input id="saved-query" name="saved_q" type="search" maxlength="200" value="<%= Rack::Utils.escape_html(@saved_query) %>">
    <input type="hidden" name="liked_page" value="<%= @liked_page %>">
    <button type="submit">Search saved</button>
    <% unless @saved_query.empty? %>
      <a href="/profile?liked_page=<%= @liked_page %>#saved-memes">Clear search</a>
    <% end %>
  </form>
  <% if !@saved_load_error && !@saved_query.empty? %>
    <p role="status"><%= @saved_matches %> saved matches</p>
  <% end %>
  
  <% if @saved_load_error %>
    <p role="alert">We could not load your saved memes. This does not mean your favorites were removed.</p>
    <p><a href="/profile?saved_page=<%= @saved_page %><%= Rack::Utils.escape_html(@saved_query_suffix) %>#saved-memes">Try loading Saved again</a></p>
  <% elsif @saved_memes.empty? && !@saved_query.empty? %>
    <p>No saved memes match this search. Try another title or community, or clear the search.</p>
  <% elsif @saved_memes.empty? %>
    <p style="text-align: center;">No saved memes yet. Use Save while browsing to keep favorites in your account.</p>
    <p style="text-align: center;"><a href="/random">Find a meme to save</a></p>
  <% else %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px;">
      <% @saved_memes.each do |saved| %>
        <a id="saved-card-<%= saved['id'].to_i %>" href="/saved/<%= saved['id'].to_i %>?saved_page=<%= @saved_page %><%= Rack::Utils.escape_html(@saved_query_suffix) %>" style="display: block; color: inherit; text-decoration: none; border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
          <img src="<%= Rack::Utils.escape_html(MediaUrl.safe(saved["meme_url"]) || "/images/meme-placeholder.svg") %>" alt="<%= Rack::Utils.escape_html(saved["meme_title"].to_s) %>" style="width: 100%; height: 200px; object-fit: cover;">
          <div style="padding: 10px;">
            <p style="margin: 0; font-size: 0.9rem; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= Rack::Utils.escape_html(saved["meme_title"].to_s) %></p>
            <p style="margin: 5px 0 0 0; font-size: 0.8rem; color: #666;">r/<%= Rack::Utils.escape_html(saved["meme_subreddit"].to_s) %></p>
            <p style="margin: 5px 0 0 0; font-size: 0.75rem; color: #999;">Saved: <%= saved["saved_at"] %></p>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>

  <% if !@saved_load_error && @saved_pages && @saved_pages > 1 %>
    <nav aria-label="Saved meme pages" style="display: flex; justify-content: center; gap: 24px; padding: 16px;">
      <% if @saved_page > 1 %>
        <a rel="prev" href="/profile?liked_page=<%= @liked_page %>&amp;saved_page=<%= @saved_page - 1 %><%= Rack::Utils.escape_html(@saved_query_suffix) %>#saved-memes">← Previous favorites</a>
      <% end %>
      <span>Page <%= @saved_page %> of <%= @saved_pages %></span>
      <% if @saved_page < @saved_pages %>
        <a rel="next" href="/profile?liked_page=<%= @liked_page %>&amp;saved_page=<%= @saved_page + 1 %><%= Rack::Utils.escape_html(@saved_query_suffix) %>#saved-memes">More favorites →</a>
      <% end %>
    </nav>
  <% end %>

  <div style="margin-top: 30px;">
    <a href="/random" style="padding: 10px 20px; background: #e52e71; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;">Browse Memes</a>
    <%= erb :'partials/_logout_form' %>
  </div>

  <!-- Ad improvement: this page had zero ad inventory before, despite
       real per-user content (liked/saved meme grids). Gated on combined
       liked+saved count against AdSense's minimum-content policy
       (should_show_ads_for_content? expects an Array, so pass a
       placeholder array of that combined size rather than a bare
       integer) - a brand-new account with nothing liked/saved yet
       shouldn't get an ad here, same reasoning as /search's empty state. -->
  <% if should_show_ads_for_content?(Array.new(@liked_memes.size + @saved_memes.size)) %>
    <%= render_hero_ad %>
  <% end %>
</div>
