<!-- Meme Metadata Partial -->
<div class="meme-info-header">
  <div class="meme-title" id="viewer-meme-title"><%= Rack::Utils.escape_html(@meme&.dig('title') || 'Loading...') %></div>
  <button type="button" class="title-toggle-btn" id="title-toggle" data-action="toggle-meme-title" aria-controls="viewer-meme-title" aria-expanded="true" title="Toggle title (T)">
    Hide title
  </button>
</div>

<% if @meme %>
  <% collection_name = collection_name_for_subreddit(@meme['subreddit']) %>
  <% rarity_data = calculate_rarity(@meme) %>
  
  <div class="refined-collection-badge">
    <span class="meme-subreddit"><a href="/search?q=<%= Rack::Utils.escape_html(URI.encode_www_form_component(@meme['subreddit'].to_s)) %>" title="Search this community"><%= Rack::Utils.escape_html(collection_name.to_s) %></a></span>
    <% if rarity_data[:label] != 'Common' %>
      <span class="rarity-indicator rarity-<%= rarity_data[:label].downcase %>">
        <%= rarity_data[:icon] %> <%= rarity_data[:label] %>
      </span>
    <% end %>
  </div>
  
  <% signal = generate_curation_signal(@meme) %>
  <div class="curation-signal curation-signal-<%= signal[:type] %>">
    <span class="signal-icon"><%= signal[:icon] %></span>
    <span class="signal-text"><%= signal[:message] %></span>
  </div>
<% end %>

<div class="meme-meta-wrapper">
  <div class="meme-meta">
  <% source_path = RedditSource.path(@reddit_path || @meme&.dig('permalink')) %>
  <% if source_path %>
    <a href="https://www.reddit.com<%= Rack::Utils.escape_html(source_path) %>"
       target="_blank" rel="noopener" class="reddit-link refined-source-link" title="View original post on Reddit">
      Source →
    </a>
  <% end %>
  </div>
</div>
