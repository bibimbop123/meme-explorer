<!-- ROADMAP.md Phase 2: real Stripe-backed premium tier (ad-free) -
     see lib/services/subscription_service.rb and
     routes/premium_routes.rb. Renders inside layout.erb like every
     other real page (leaderboard.erb, profile.erb, etc.), not a
     standalone document. -->
<div style="max-width: 700px; margin: 30px auto; padding: 20px;">
  <h1 style="text-align: center;">✨ Meme Explorer Premium</h1>
  <p style="text-align: center; color: #666; margin-bottom: 30px;">
    Go ad-free. Same personalization, none of the ads.
  </p>

  <% if @already_premium %>
    <div style="background: #d4edda; color: #155724; padding: 20px; border-radius: 8px; text-align: center; margin-bottom: 20px;">
      <strong>✅ You're already Premium!</strong>
      <p style="margin: 8px 0 0;">Enjoy your ad-free experience.</p>
    </div>
  <% elsif !@stripe_configured %>
    <div style="background: #fff3cd; color: #856404; padding: 20px; border-radius: 8px; text-align: center;">
      <strong>Premium checkout isn't available yet.</strong>
      <p style="margin: 8px 0 0;">Check back soon!</p>
    </div>
  <% else %>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
      <div style="border: 2px solid #ddd; border-radius: 12px; padding: 24px; text-align: center;">
        <h2 style="margin: 0 0 8px;">Monthly</h2>
        <p style="font-size: 14px; color: #666; margin-bottom: 20px;">Cancel anytime</p>
        <form action="/premium/checkout" method="POST">
          <input type="hidden" name="plan" value="monthly">
          <button type="submit" <%= 'disabled' unless @monthly_price_id %>
                  style="width: 100%; padding: 12px; background: #e52e71; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 15px;">
            Go Premium Monthly
          </button>
        </form>
      </div>

      <div style="border: 2px solid #e52e71; border-radius: 12px; padding: 24px; text-align: center; position: relative;">
        <span style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #e52e71; color: white; padding: 2px 12px; border-radius: 10px; font-size: 12px; font-weight: bold;">BEST VALUE</span>
        <h2 style="margin: 0 0 8px;">Yearly</h2>
        <p style="font-size: 14px; color: #666; margin-bottom: 20px;">2 months free vs. monthly</p>
        <form action="/premium/checkout" method="POST">
          <input type="hidden" name="plan" value="yearly">
          <button type="submit" <%= 'disabled' unless @yearly_price_id %>
                  style="width: 100%; padding: 12px; background: #e52e71; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 15px;">
            Go Premium Yearly
          </button>
        </form>
      </div>
    </div>
  <% end %>

  <div style="margin-top: 20px;">
    <h3>What you get</h3>
    <ul style="line-height: 1.8;">
      <li>🚫 No ads, anywhere in the app</li>
      <li>🎯 The same personalized selection everyone gets, uninterrupted</li>
      <li>❤️ Your support keeps Meme Explorer independent</li>
    </ul>
  </div>

  <p style="margin-top: 30px; text-align: center;">
    <a href="/random" style="color: #2196F3; text-decoration: none; font-weight: 600;">← Back to Memes</a>
  </p>
</div>
