<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meme Explorer 😎 - Best Memes from Reddit</title>
  
  <!-- SEO Meta Tags -->
  <meta name="description" content="Discover trending memes from Reddit! Keyboard shortcuts: Space=Random, Cmd+K=Dark Mode. Browse funny, wholesome, and dank memes featuring Tattoo Annie.">
  <meta name="keywords" content="memes, reddit memes, funny memes, wholesome memes, dank memes, meme explorer, tattoo annie, simpsons memes">
  <meta name="author" content="Meme Explorer">
  <meta name="theme-color" content="#e52e71">
  
  <!-- Site Verification -->
  <meta name="site-verification" content="propellerads-verified" />
  
  <!-- Open Graph / Facebook Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= request.base_url %>">
  <% if @meme && @meme['title'] %>
    <!-- 🎬 CRITERION COLLECTION: Enhanced sharing for specific memes -->
    <% collection = collection_name_for_subreddit(@meme['subreddit']) rescue "Meme Explorer" %>
    <% signal = generate_curation_signal(@meme) rescue {message: "A curated selection"} %>
    <meta property="og:title" content="From <%= collection %> | Meme Explorer">
    <meta property="og:description" content="<%= signal[:message] %>: <%= @meme['title'].gsub('"', "'")[0..150] %>">
    <meta property="og:image" content="<%= @meme['url'] || @image_src %>">
  <% else %>
    <meta property="og:title" content="Meme Explorer 😎 - Discover the Best Memes from Reddit">
    <meta property="og:description" content="Explore trending memes featuring Tattoo Annie from The Simpsons! Browse funny, wholesome, and dank memes from top Reddit communities.">
    <meta property="og:image" content="<%= request.base_url %>/images/meme-placeholder-social.svg">
  <% end %>
  <meta property="og:image:secure_url" content="<%= request.base_url.gsub('http:', 'https:') %>/images/meme-placeholder-social.svg">
  <meta property="og:image:type" content="image/svg+xml">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Tattoo Annie from The Simpsons - Meme Explorer mascot representing the fun and entertaining world of internet memes">
  <meta property="og:site_name" content="Meme Explorer">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= request.base_url %>">
  <meta name="twitter:title" content="Meme Explorer 😎 - Discover the Best Memes">
  <meta name="twitter:description" content="Explore trending memes featuring Tattoo Annie from The Simpsons! Browse funny, wholesome, and dank memes from Reddit.">
  <meta name="twitter:image" content="<%= request.base_url %>/images/meme-placeholder-social.svg">
  <meta name="twitter:image:alt" content="Meme Explorer - Discover the funniest memes from Reddit">
  <meta name="twitter:creator" content="@MemeExplorer">
  
  <!-- Additional Meta Tags -->
  <meta name="robots" content="index, follow">
  <meta name="googlebot" content="index, follow">
  <meta name="google" content="nositelinkssearchbox">
  <link rel="canonical" href="<%= request.base_url %><%= request.path %>">
  
  <!-- Favicon and Icons -->
  <link rel="icon" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon.png">
  <link rel="manifest" href="/manifest.json">
  
  <!-- 🚀 LCP OPTIMIZATION: Preconnect to external domains -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  
  <style>
    /* Mobile navbar optimization - hide non-essential items on mobile */
    @media (max-width: 768px) {
      nav a[href*="/category/"],
      nav a[href="/profile"],
      nav a[href="/admin"] {
        display: none;
      }
      
      nav {
        gap: 0.5rem;
      }
      
      nav a {
        padding: 0.4rem 0.6rem;
        font-size: 0.85rem;
      }
    }
  </style>
  <script>
    // Initialize theme on page load
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    
    if (savedTheme === 'light') {
      document.documentElement.classList.remove('dark-mode');
    } else if (savedTheme === 'dark') {
      document.documentElement.classList.add('dark-mode');
    } else if (prefersDark) {
      document.documentElement.classList.add('dark-mode');
    }
  </script>
<link rel="stylesheet" href="/css/navigation.css">

<!-- Phase 2: Global Error Handler -->
<!-- Loaded early (not deferred) and NOT re-imported by main.js, so it can
     catch errors that happen during initial page parse/render, before the
     deferred Vite bundle even loads. (It used to be imported by main.js
     too, which meant a second `window.addEventListener('error', ...)` and
     a second `unhandledrejection` listener got registered once the bundle
     loaded - every uncaught error and rejection was logged/reported to
     Sentry twice. Removed the duplicate import from public/js/main.js so
     this is the single source of truth.) -->
<script src="/js/error-handler.js"></script>
    
    
      






<!-- 🎯 CLS Optimization Stylesheets -->
<link rel="stylesheet" href="/css/image-cls-fix.css">
<link rel="stylesheet" href="/css/content-visibility.css">
<link rel="stylesheet" href="/css/cls-optimization.css">
<link rel="stylesheet" href="/css/meme-transition.css">
<link rel="stylesheet" href="/css/meme-description.css">

</head>
<body>
  <!-- Phase 2: Accessibility - Skip to Content -->
  <a href="#main-content" class="skip-to-content">Skip to content</a>
  <!-- ================= HEADER ================= -->
  <header>
    <%= erb :'partials/_simplified_nav' %>
  </header>

  <!-- ================= MAIN CONTENT ================= -->
  <main id="main-content" role="main"><%= yield %></main>

  <!-- ================= FOOTER ================= -->
  <footer>
    <div class="footer-content">
      <p>Built with Sinatra | &copy; 2026 Meme Explorer</p>
      <nav class="footer-links">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/dmca">DMCA</a>
        <a href="/contact">Contact</a>
      </nav>
      <p class="footer-note">Content sourced from <a href="https://www.reddit.com" target="_blank" rel="noopener">Reddit</a> | Not affiliated with Reddit, Inc.</p>
    </div>
  </footer>
  
  <style>
    footer {
      background: #2c2c2c;
      color: #e0e0e0;
      padding: 2rem 1rem;
      margin-top: 4rem;
      text-align: center;
    }
    
    .footer-content {
      max-width: 1200px;
      margin: 0 auto;
e    }
    
    .footer-links {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin: 1rem 0;
      flex-wrap: wrap;
    }
    
    .footer-links a {
      color: #e0e0e0;
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    
    .footer-links a:hover {
      color: #667eea;
    }
    
    .footer-note {
      font-size: 0.85rem;
      opacity: 0.8;
      margin-top: 1rem;
    }
    
    .footer-note a {
      color: #667eea;
      text-decoration: none;
    }
    
    .footer-note a:hover {
      text-decoration: underline;
    }
    
    @media (max-width: 768px) {
      .footer-links {
        gap: 1rem;
      }
      
      .footer-links a {
        font-size: 0.85rem;
      }
    }
  </style>

  <!-- ================= SESSION DATA & GAMIFICATION ================= -->
  <script>
    window.sessionLikedMemes = <%= (session[:liked_memes] || []).to_json %>;
    
    // Level-up celebration with screen shake and confetti
    <% if session[:last_xp_gain] && session[:last_xp_gain][:leveled_up] %>
      setTimeout(() => {
        // Screen shake for impact!
        document.body.classList.add('screen-shake');
        setTimeout(() => document.body.classList.remove('screen-shake'), 500);
        
        // Confetti celebration!
        if (window.particleSystem) {
          window.particleSystem.confetti(window.innerWidth / 2, window.innerHeight / 2, 60);
        }
        
        // Level up sound!
        if (window.soundSystem) {
          window.soundSystem.play('levelUp');
        }
        
        const modal = document.createElement('div');
        modal.className = 'level-up-modal';
        modal.innerHTML = `
          <div class="level-up-content">
            <h2>🎉 LEVEL UP! 🎉</h2>
            <p>You're now Level <%= session[:last_xp_gain][:level] %>!</p>
            <p class="level-title" style="font-size: 1.3rem; margin: 0.5rem 0;"><%= session[:last_xp_gain][:title] %></p>
            <p>+<%= session[:last_xp_gain][:xp_gained] %> XP</p>
            <button onclick="this.parentElement.parentElement.remove()" style="margin-top: 1rem; padding: 0.75rem 2rem; font-size: 1.1rem; border: none; background: white; color: #f5576c; border-radius: 10px; cursor: pointer; font-weight: bold; transition: all 0.2s;">Let's GOOO! 🚀</button>
          </div>
        `;
        document.body.appendChild(modal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.remove();
        });
      }, 500);
      <% session.delete(:last_xp_gain) %>
    <% elsif session[:last_xp_gain] %>
      setTimeout(() => {
        const notification = document.createElement('div');
        notification.className = 'xp-notification';
        notification.textContent = '+<%= session[:last_xp_gain][:xp_gained] %> XP';
        document.body.appendChild(notification);
        setTimeout(() => notification.remove(), 3000);
      }, 300);
      <% session.delete(:last_xp_gain) %>
    <% end %>
    
    // Dark mode toggle for entire UI
    const darkModeToggle = document.getElementById('darkModeToggle');
    if (darkModeToggle) {
      // Set initial button state
      const isDarkMode = document.documentElement.classList.contains('dark-mode');
      darkModeToggle.textContent = isDarkMode ? '☀️' : '🌙';
      
      // Toggle on click
      darkModeToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const html = document.documentElement;
        const newIsDark = !html.classList.contains('dark-mode');
        
        html.classList.toggle('dark-mode');
        localStorage.setItem('theme', newIsDark ? 'dark' : 'light');
        darkModeToggle.textContent = newIsDark ? '☀️' : '🌙';
      });
    }
  </script>

  <!-- ================= NAVIGATION JS ================= -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const prevBtn = document.getElementById("prev-btn");
      const nextBtn = document.getElementById("next-btn");

      prevBtn?.addEventListener("click", () => {
        window.location.href = "/random";
      });
      nextBtn?.addEventListener("click", () => {
        window.location.href = "/random";
      });

      // Keyboard shortcuts
      document.addEventListener("keydown", (e) => {
        // Space bar = load random meme
        if ((e.code === "Space" || e.key === " ") && document.activeElement.tagName !== "INPUT") {
          e.preventDefault();
          window.location.href = "/random";
        }
        
        // Cmd+K (Mac) or Ctrl+K (Windows/Linux) = toggle dark mode
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          const darkModeToggle = document.getElementById('darkModeToggle');
          if (darkModeToggle) {
            darkModeToggle.click();
          }
        }
      });
    });
  </script>
  
  <!-- ================= GALLERY SCRIPT (if galleries are present) ================= -->
  <% if defined?(gallery_script) %>
    <%= gallery_script %>
  <% end %>
  
  <!-- ================= SOUND, HAPTIC & PARTICLE SYSTEMS ================= -->
  
  
  
  <script>
    // Sound toggle functionality
    const soundToggle = document.getElementById('soundToggle');
    if (soundToggle) {
      // Set initial button state
      soundToggle.textContent = window.soundSystem.isMuted() ? '🔇' : '🔊';
      
      // Toggle on click
      soundToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const isMuted = window.soundSystem.toggleMute();
        soundToggle.textContent = isMuted ? '🔇' : '🔊';
        
        // Play test sound if unmuted
        if (!isMuted) {
          window.soundSystem.play('achievement');
        }
        
        // Haptic feedback
        window.hapticSystem.trigger('light');
      });
    }
  </script>
  
  <!-- ================= ACTIVITY TRACKER (real-time user counts) ================= -->
  
  
  <!-- ================= SURPRISE REWARDS (Priority 2) ================= -->
  
  
  <!-- ================= AD SYSTEM CONFIGURATION ================= -->
  <script>
    // Ad configuration from environment
    window.AD_FREQUENCY = <%= ENV['AD_FREQUENCY'] || 12 %>;
    window.GOOGLE_ADSENSE_CLIENT = <%= ENV['GOOGLE_ADSENSE_CLIENT'].to_json %>;
    window.GOOGLE_AD_SLOT_SQUARE = <%= ENV['GOOGLE_AD_SLOT_SQUARE'].to_json %>;
    window.GOOGLE_AD_SLOT_BANNER = <%= ENV['GOOGLE_AD_SLOT_BANNER'].to_json %>;
    window.GOOGLE_AD_SLOT_NATIVE = <%= ENV['GOOGLE_AD_SLOT_NATIVE'].to_json %>;
  </script>
  <script src="/js/ad-manager.js"></script>
  
  <!-- ================= PUSH NOTIFICATIONS (Priority 1) ================= -->
  <% if logged_in? %>
  <script>
    window.PUSH_NOTIFICATIONS_CONFIG = {
      enabled: true,
      vapidPublicKey: <%= (ENV["VAPID_PUBLIC_KEY"] || "").to_json %>
    };
  </script>
  <script src="/js/push-notifications.js" defer></script>
  <% end %>
  
