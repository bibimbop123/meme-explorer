<div id="initial-meme-data" hidden data-meme="<%= Rack::Utils.escape_html((@meme || {}).merge('url' => (@meme && (@meme['url'] || @meme['file'])), 'impression_id' => @impression_id, 'likes' => @likes, 'liked' => !!@liked, 'saved' => !!@saved).to_json) %>"></div>
<div id="viewer-share-data" hidden data-share-path="<%= Rack::Utils.escape_html(@share_path.to_s) %>"></div>
<div class="page-wrapper simplified-mode">
  <nav class="viewer-navigation" aria-label="Meme navigation">
    <button type="button" class="control-btn prev-button" id="prev-btn" data-action="prev-meme" title="Previous meme (Left arrow outside galleries)" disabled>← Previous</button>
    <button type="button" class="control-btn next-button" id="next-btn" data-action="next-meme" title="Next meme (Space or Right arrow)">Next meme →</button>
  </nav>
  <% if @permalink_page && params[:save_after_login] == '1' && logged_in? %>
    <p role="status"><%= @saved ? 'Saved to your favorites.' : 'You are signed in, but this meme has not been saved. Press Save to favorites to try again.' %></p>
  <% end %>
  <section id="save-sign-in" hidden aria-label="Save to your account" style="max-width: 700px; margin: 16px auto; padding: 16px;">
    <p>This meme has not been saved. Sign in to finish saving it to your favorites.</p>
    <a href="/login">Sign in to save favorites</a>
    <p>Before leaving, use Share to keep an exact link to this meme if available.</p>
  </section>
  <section id="manual-share" hidden aria-label="Copy exact meme link" style="max-width: 700px; margin: 16px auto; padding: 16px;">
    <label for="manual-share-url">Exact link to the meme you chose to share</label>
    <p id="manual-share-help">Automatic sharing is unavailable. Select this link and copy it using your device's copy command.</p>
    <input id="manual-share-url" type="url" readonly aria-describedby="manual-share-help" style="width: 100%; padding: 12px;">
  </section>
  <% if @search_return_path %>
    <p><a href="<%= Rack::Utils.escape_html(@search_return_path) %>">← Back to search results</a></p>
  <% end %>
  <p id="viewer-status" class="viewer-sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
  <p id="feed-supply-status" role="status" <%= 'hidden' unless @meme && @meme['inventory_exhausted'] %>>You've reached the end of the currently available unseen memes. Showing the least recently selected items again; try Search or return later for more.</p>
  <div class="meme-container">
    <!-- Left Ad Column -->
    <% if ad_placeholder_preview? && should_show_ads? %>
      <div class="ad-container" data-position="left">
        <%= render_ad_unit(0, format: 'vertical') %>
      </div>
    <% end %>

    <!-- Meme Display -->
    <div class="meme-display" id="meme-display" aria-busy="false" data-impression-id="<%= Rack::Utils.escape_html(@impression_id.to_s) %>" data-meme-url="<%= Rack::Utils.escape_html((@meme && (@meme['url'] || @meme['file'])) || @image_src || '') %>">
      <%= erb :'random/display' %>
    </div>
    
    <!-- Meme Info/Metadata -->
    <div class="meme-info" id="meme-info">
      <%= erb :'random/metadata' %>
    </div>

    <!-- Control Buttons -->
    <div class="meme-controls">
      <%= erb :'random/controls' %>
    </div>

    <!-- Right Ad Column -->
    <% if ad_placeholder_preview? && should_show_ads? %>
      <div class="ad-container" data-position="right">
        <%= render_ad_unit(1, format: 'vertical') %>
      </div>
    <% end %>
  </div>
</div>

<!-- Demo slots require explicit non-production preview and stay in normal flow.
     These are not billable units and do not control the site-wide ad loader. -->
<%= erb :'partials/_feed_preferences' if discovery_controls_enabled? %>
<details id="recently-viewed" style="max-width: 800px; margin: 24px auto; padding: 16px;">
  <summary>Recently viewed</summary>
  <p>Up to 20 recently viewed memes. Images and videos with exact links survive refreshes in this tab when browser storage is available; reopening them loads their current page. Other entries, including galleries, remain page-only. Clear the list on shared devices.</p>
  <button type="button" id="clear-recent-memes">Clear list</button>
  <div id="recent-meme-list"><p>No viewed memes yet.</p></div>
</details>
<%= render_sponsor_slot %>
<%= render_anchor_ad %>
<% if @permalink_page %>
  <section class="permalink-cta-card" aria-label="Explore more memes">
    <p><strong>Want more quick visual humor?</strong></p>
    <div class="permalink-cta-actions">
      <a href="/random" class="permalink-cta-btn">🔥 Find your next favorite →</a>
      <a href="/trending" class="permalink-cta-secondary">🏆 See Trending Top Memes</a>
    </div>
  </section>
<% end %>

<!--
  NOTE: Do NOT add a second <script src="/js/modules/meme-app.js"> tag here.
  layout.erb already loads /dist/bundle.js (Vite bundle) on every page, which
  includes meme-app.js -> MemeNavigation and binds a single Space-bar keydown
  listener. Loading meme-app.js a second time here previously caused TWO
  MemeNavigation instances to both handle each Space press, firing
  loadNextMeme() twice concurrently - two competing fade/fetch/render cycles
  racing on the same #meme-display element, which looked like an auto-playing
  carousel instead of a single clean "one meme at a time" transition.
-->
