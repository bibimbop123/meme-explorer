<div class="page-wrapper simplified-mode">
  <div class="meme-container">
    <!-- Left Ad Column -->
    <% if should_show_ads? %>
      <div class="ad-container" data-position="left">
        <%= render_ad_unit(0, format: 'vertical') %>
      </div>
    <% end %>

    <!-- Meme Display -->
    <div class="meme-display" id="meme-display">
      <%= erb :'random/display' %>
    </div>
    
    <!-- Meme Info/Metadata -->
    <div class="meme-info" id="meme-info">
      <%= erb :'random/metadata' %>
    </div>

    <!-- Control Buttons -->
    <div class="meme-controls">
      <%= erb :'random/controls' %>
    </div>

    <!-- Right Ad Column -->
    <% if should_show_ads? %>
      <div class="ad-container" data-position="right">
        <%= render_ad_unit(1, format: 'vertical') %>
      </div>
    <% end %>
  </div>
</div>

<!--
  NOTE: Do NOT add a second <script src="/js/modules/meme-app.js"> tag here.
  layout.erb already loads /dist/bundle.js (Vite bundle) on every page, which
  includes meme-app.js -> MemeNavigation and binds a single Space-bar keydown
  listener. Loading meme-app.js a second time here previously caused TWO
  MemeNavigation instances to both handle each Space press, firing
  loadNextMeme() twice concurrently - two competing fade/fetch/render cycles
  racing on the same #meme-display element, which looked like an auto-playing
  carousel instead of a single clean "one meme at a time" transition.
-->
