<link rel="stylesheet" href="/css/search.css">
<div class="search-page">
  <h1>Search Results</h1>
  <form action="/search" method="get" role="search" class="search-form">
    <label for="meme-search">Search titles or communities</label>
    <input id="meme-search" name="q" type="search" maxlength="200" aria-describedby="search-feedback" aria-invalid="<%= @search_error ? 'true' : 'false' %>" value="<%= Rack::Utils.escape_html(@query.to_s) %>" placeholder="Try cats, programming, wholesome" class="search-input">
    <button type="submit" class="search-submit">Search</button>
  </form>
  <p class="search-query-note">
    <% if @query %>
      Searching for: <strong><%= Rack::Utils.escape_html(@query.to_s) %></strong>
    <% else %>
      Search by a title, topic, or community.
    <% end %>
  </p>

  <% if should_show_ads_for_content?(@results) %>
    <%= render_hero_ad %>
  <% end %>

  <% if @search_error %>
    <p id="search-feedback" role="alert"><%= Rack::Utils.escape_html(@search_error.to_s) %>. Edit your query and try again.</p>
  <% elsif @query.nil? %>
    <p id="search-feedback">Find a meme by topic or community. Try cats, programming, or wholesome.</p>
    <div class="search-topic-pills" aria-label="Popular humor topics and communities">
      <% %w[wholesomememes programmerhumor dankmemes me_irl animalsbeingderps starterpacks cats].each do |topic| %>
        <a href="/search?q=<%= Rack::Utils.escape_html(URI.encode_www_form_component(topic)) %>" class="search-pill">r/<%= Rack::Utils.escape_html(topic) %></a>
      <% end %>
    </div>
  <% elsif @results.empty? %>
    <div id="search-feedback" class="search-empty" role="status">
      <h2>No matching memes</h2>
      <p>No memes found for “<%= Rack::Utils.escape_html(@query.to_s) %>”.</p>
      <p>Try fewer words, check the spelling, or search a community name without <code>r/</code>. Search matches titles and community names, not text inside images.</p>
      <p class="search-recovery"><a href="/search">Start a new search</a><a href="/trending">Browse trending memes</a><a href="/random">Explore random memes</a></p>
    </div>
  <% else %>
    <p id="search-feedback" role="status"><%= @results.size %> results found.</p>
    <div class="search-results-grid">
      <% @results.each_with_index do |meme, index| %>
        <% if show_ad_at_position?(index) %>
          <div class="search-ad-slot">
            <%= render_ad_unit(index, format: 'native', position: 'search-results') %>
          </div>
        <% end %>
        <div class="search-result-card">

          <!-- Thumbnail -->
          <% image_url = MediaUrl.safe(meme["url"] || meme["file"]) || "/images/meme-placeholder.svg" %>
          <div class="search-result-thumb">
            <img src="<%= Rack::Utils.escape_html(image_url) %>"
                 loading="lazy"
                 alt="<%= Rack::Utils.escape_html(meme['title'].to_s) %>"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div class="placeholder-minimal" style="display:none;">
              <div class="placeholder-icon">🖼️</div>
              <p>Image unavailable</p>
            </div>

            <!-- Source Badge -->
            <div class="search-result-badge<%= ' search-result-badge--reddit' if meme['source'] == 'reddit' %>">
              <%= Rack::Utils.escape_html(meme['source'].to_s.upcase) %>
            </div>
          </div>

          <!-- Content -->
          <div class="search-result-body">
            <h3 class="search-result-title">
              <%= Rack::Utils.escape_html(meme['title'].to_s) %>
            </h3>

            <p class="search-result-sub">
              <a href="/search?q=<%= Rack::Utils.escape_html(URI.encode_www_form_component(meme['subreddit'].to_s)) %>">r/<%= Rack::Utils.escape_html(meme['subreddit'].to_s) %></a>
            </p>

            <!-- Engagement Stats -->
            <div class="search-result-stats">
              <div class="search-stat">
                <div class="search-stat-value-likes"><%= meme['likes'] %></div>
                <div class="search-stat-label">Likes</div>
              </div>
              <div class="search-stat">
                <div class="search-stat-value-views"><%= meme['views'] || '0' %></div>
                <div class="search-stat-label">Views</div>
              </div>
            </div>

            <!-- View Button (stretched link: makes the whole card clickable) -->
            <a id="search-result-<%= index %>" href="<%= Rack::Utils.escape_html(meme['detail_path'] || image_url) %>" class="search-result-cta">
              View Meme
            </a>
          </div>
        </div>
      <% end %>
    </div>

    <p class="search-results-count">
      Showing <strong><%= @results.size %></strong> of <strong><%= @result_total || @results.size %></strong> results
    </p>
    <% if @page_count && @page_count > 1 %>
      <nav aria-label="Search result pages" class="search-pagination">
        <% if @page > 1 %>
          <a rel="prev" href="/search?<%= Rack::Utils.escape_html(URI.encode_www_form(q: @query, page: @page - 1)) %>">← Previous results</a>
        <% end %>
        <span>Page <%= @page %> of <%= @page_count %></span>
        <% if @page < @page_count %>
          <a rel="next" href="/search?<%= Rack::Utils.escape_html(URI.encode_www_form(q: @query, page: @page + 1)) %>">Next results →</a>
        <% end %>
      </nav>
    <% end %>
  <% end %>

  <p class="search-back-home">
    <a href="/">← Back to Home</a>
  </p>
</div>

<!-- Mobile ad surface (same sticky anchor pattern as /random, /trending) -
     also gated on real content per AdSense policy, not just "ads
     globally enabled". -->
<% if should_show_ads_for_content?(@results) %>
  <%= render_anchor_ad %>
<% end %>
