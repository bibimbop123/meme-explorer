<div style="max-width: 1200px; margin: 0 auto; padding: 20px;">
  <h1 style="margin-bottom: 10px;">Search Results</h1>
  <form action="/search" method="get" role="search" style="display: flex; flex-wrap: wrap; gap: 12px; margin: 20px 0;">
    <label for="meme-search">Search titles or communities</label>
    <input id="meme-search" name="q" type="search" maxlength="200" aria-describedby="search-feedback" aria-invalid="<%= @search_error ? 'true' : 'false' %>" value="<%= Rack::Utils.escape_html(@query.to_s) %>" placeholder="Try cats, programming, wholesome" style="flex: 1; min-width: 180px; padding: 12px;">
    <button type="submit" style="padding: 12px 20px;">Search</button>
  </form>
  <p style="color: #666; margin-bottom: 20px;">
    <% if @query %>
      Searching for: <strong><%= Rack::Utils.escape_html(@query.to_s) %></strong>
    <% else %>
      Search by a title, topic, or community.
    <% end %>
  </p>

  <!-- Ad improvement: this page had zero ad inventory at all before -
       gated on should_show_ads_for_content?, which enforces AdSense's
       minimum-substantial-content policy (MIN_ITEMS_FOR_ADS = 6, see
       lib/helpers/ad_helpers.rb) rather than showing an ad above a
       near-empty results page. -->
  <% if should_show_ads_for_content?(@results) %>
    <%= render_hero_ad %>
  <% end %>

  <% if @search_error %>
    <p id="search-feedback" role="alert"><%= Rack::Utils.escape_html(@search_error.to_s) %>. Edit your query and try again.</p>
  <% elsif @query.nil? %>
    <p id="search-feedback">Find a meme by topic or community. Try cats, programming, or wholesome.</p>
  <% elsif @results.empty? %>
    <div id="search-feedback" style="text-align: center; padding: 60px 20px; background: #f5f5f5; border-radius: 12px;">
      <p style="font-size: 18px; color: #999;">No memes found for "<%= Rack::Utils.escape_html(@query.to_s) %>" 😢</p>
      <p style="color: #aaa; margin-top: 10px;">Try a different search term!</p>
    </div>
  <% else %>
    <p id="search-feedback" role="status"><%= @results.size %> results found.</p>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px;">
      <% @results.each_with_index do |meme, index| %>
        <% if show_ad_at_position?(index) %>
          <div style="grid-column: 1 / -1;">
            <%= render_ad_unit(index, format: 'native', position: 'search-results') %>
          </div>
        <% end %>
        <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: transform 0.2s, box-shadow 0.2s; cursor: pointer;"
             onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)';"
             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.1)';">

          <!-- Thumbnail -->
          <% image_url = MediaUrl.safe(meme["url"] || meme["file"]) || "/images/meme-placeholder.svg" %>
          <div style="position: relative; width: 100%; height: 180px; background: #f0f0f0; overflow: hidden;">
            <img src="<%= Rack::Utils.escape_html(image_url) %>"
                 loading="lazy"
                 alt="<%= Rack::Utils.escape_html(meme['title'].to_s) %>"
                 style="width: 100%; height: 100%; object-fit: cover;"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
      <div class="placeholder-minimal" style="display:none;">
        <div class="placeholder-icon">🖼️</div>
        <p>Image unavailable</p>
      </div>

            <!-- Source Badge -->
            <div style="position: absolute; top: 8px; right: 8px; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: bold; background: <%= meme['source'] == 'reddit' ? '#FF4500' : '#4caf50' %>; color: white;">
              <%= Rack::Utils.escape_html(meme['source'].to_s.upcase) %>
            </div>
          </div>

          <!-- Content -->
          <div style="padding: 12px;">
            <h3 style="margin: 0 0 8px; font-size: 14px; font-weight: 600; line-height: 1.3; color: #333; min-height: 40px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
              <%= Rack::Utils.escape_html(meme['title'].to_s) %>
            </h3>

            <p style="margin: 8px 0; font-size: 12px; color: #666;">
              r/<%= Rack::Utils.escape_html(meme['subreddit'].to_s) %>
            </p>

            <!-- Engagement Stats -->
            <div style="display: flex; gap: 12px; padding-top: 12px; border-top: 1px solid #eee; margin-top: 12px; font-size: 13px;">
              <div style="flex: 1; text-align: center;">
                <div style="color: #e52e71; font-weight: 600;"><%= meme['likes'] %></div>
                <div style="color: #999; font-size: 11px;">Likes</div>
              </div>
              <div style="flex: 1; text-align: center;">
                <div style="color: #2196F3; font-weight: 600;"><%= meme['views'] || '0' %></div>
                <div style="color: #999; font-size: 11px;">Views</div>
              </div>
            </div>

            <!-- View Button -->
            <a id="search-result-<%= index %>" href="<%= Rack::Utils.escape_html(meme['detail_path'] || image_url) %>"
               style="display: block; margin-top: 12px; padding: 8px; text-align: center; background: #ff9800; color: white; text-decoration: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: background 0.2s;"
               onmouseover="this.style.background='#f57c00';"
               onmouseout="this.style.background='#ff9800';">
              View Meme
            </a>
          </div>
        </div>
      <% end %>
    </div>

    <p style="text-align: center; color: #999; margin-top: 30px;">
      Showing <strong><%= @results.size %></strong> of <strong><%= @result_total || @results.size %></strong> results
    </p>
    <% if @page_count && @page_count > 1 %>
      <nav aria-label="Search result pages" style="display: flex; justify-content: center; gap: 24px; padding: 16px;">
        <% if @page > 1 %>
          <a rel="prev" href="/search?<%= Rack::Utils.escape_html(URI.encode_www_form(q: @query, page: @page - 1)) %>">← Previous results</a>
        <% end %>
        <span>Page <%= @page %> of <%= @page_count %></span>
        <% if @page < @page_count %>
          <a rel="next" href="/search?<%= Rack::Utils.escape_html(URI.encode_www_form(q: @query, page: @page + 1)) %>">Next results →</a>
        <% end %>
      </nav>
    <% end %>
  <% end %>

  <p style="margin-top: 40px; text-align: center;">
    <a href="/" style="color: #2196F3; text-decoration: none; font-weight: 600;">← Back to Home</a>
  </p>
</div>

<!-- Mobile ad surface (same sticky anchor pattern as /random, /trending) -
     also gated on real content per AdSense policy, not just "ads
     globally enabled". -->
<% if should_show_ads_for_content?(@results) %>
  <%= render_anchor_ad %>
<% end %>

<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)) !important;
    }
  }

  @media (max-width: 480px) {
    div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
