<link rel="stylesheet" href="/css/auth.css">
<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title">🎪 Meme Explorer</h1>
      <p class="auth-subtitle">Reset your password</p>
    </div>

    <div class="auth-content">
      <% if @mailer_configured %>
        <p class="auth-continuity-note">Enter your account email. If an account exists, we will send a one-use reset link that expires in 30 minutes.</p>

        <form method="post" action="/password/forgot" class="auth-form" id="forgot-form">
          <input type="hidden" name="authenticity_token" value="<%= env['rack.session']['csrf'] %>">

          <div id="error-message" class="error-message" style="display: none;"></div>
          <div id="forgot-success" class="auth-notice-success" role="status" style="display: none;"></div>

          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required
                   class="form-input"
                   autocomplete="email">
          </div>

          <button type="submit" class="btn btn-primary" id="forgot-btn">
            Send Reset Link
          </button>
        </form>
      <% else %>
        <p class="auth-continuity-note">Password reset is temporarily unavailable. Please try again later or contact support.</p>
      <% end %>

      <p class="auth-footer">
        <a href="/login" class="auth-link">← Back to Login</a>
      </p>
    </div>
  </div>
</div>

<% if @mailer_configured %>
<script<%= env['meme.csp_nonce'] ? " nonce=\"#{Rack::Utils.escape_html(env['meme.csp_nonce'])}\"" : '' %>>
  document.getElementById('forgot-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const errorMsg = document.getElementById('error-message');
    const successMsg = document.getElementById('forgot-success');
    const submitBtn = document.getElementById('forgot-btn');
    const originalBtnText = submitBtn.textContent;

    errorMsg.style.display = 'none';
    errorMsg.textContent = '';
    successMsg.style.display = 'none';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    try {
      const response = await fetch('/password/forgot', { method: 'POST', body: new FormData(this) });
      const data = await response.json();

      if (data.success) {
        successMsg.textContent = data.message;
        successMsg.style.display = 'block';
        this.style.display = 'none';
      } else {
        errorMsg.textContent = data.error || 'Something went wrong. Please try again.';
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    } catch (err) {
      errorMsg.textContent = 'Network error. Please check your connection and try again.';
      errorMsg.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = originalBtnText;
    }
  });
</script>
<% end %>
