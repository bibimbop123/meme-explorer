<!-- Phase 1: Trending Page with Real Image Display -->
<link rel="stylesheet" href="/css/trending.css">
<div class="trending-header">
  <h1>🔥 Trending Memes</h1>
  
  <!-- Time Window Tabs -->
  <div class="time-window-tabs">
    <button class="tab-button" data-time-window="daily_top_10">🎯 Daily Top 10</button>
    <button class="tab-button active" data-time-window="24h">24 Hours</button>
    <button class="tab-button" data-time-window="1h">1 Hour</button>
    <button class="tab-button" data-time-window="7d">7 Days</button>
    <button class="tab-button" data-time-window="all-time">All Time</button>
  </div>

  <!-- Sort Dropdown -->
  <div class="sort-controls">
    <label for="sortDropdown">Sort By:</label>
    <select id="sortDropdown">
      <option value="trending">Trending</option>
      <option value="latest">Latest</option>
      <option value="most_liked">Most Liked</option>
      <option value="rising">Rising</option>
    </select>
  </div>
</div>

<!-- Ad improvement: hero ad above the fold, desktop and mobile both -
     this page had zero ad inventory at all before (render_hero_ad was
     defined in lib/helpers/ad_helpers.rb but never called anywhere). -->
<%= render_hero_ad %>

<!-- Desktop sidebar ad + main content, using the existing
     .content-with-sidebar/.sidebar-ad-container grid from /css/ads.css
     (only activates at >=1200px - render_sidebar_ad is itself a no-op
     when should_show_ads? is false, and .sidebar-ad-container is hidden
     entirely below 1200px, so mobile is unaffected by this wrapper). -->
<div class="content-with-sidebar">
  <div>
    <!-- Meme Cards Container -->
    <div id="trendingContainer" class="trending-container">
      <div class="loading-state">
        <p>Loading trending memes...</p>
      </div>
    </div>

    <!-- Infinite Scroll Observer -->
    <div id="scrollObserver" class="scroll-observer"></div>
  </div>

  <%= render_sidebar_ad %>
</div>

<!-- Mobile ad surface: a single sticky anchor bar, same pattern already
     used on /random - this page had no mobile ad inventory at all
     before (the left/right desktop columns don't apply here, but there
     was no mobile-specific slot either). -->
<%= render_anchor_ad %>

<!-- TrendingPage is bundled into /dist/bundle.js (via public/js/main.js
     importing public/js/trending.js) and self-boots when #trendingContainer
     is present - no standalone script tag or inline init needed here. -->
