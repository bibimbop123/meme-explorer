# Meme Explorer Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Core Application
# ============================================
RACK_ENV=production
PORT=8080
SESSION_SECRET=your-random-secret-key-here

# ============================================
# Database (PostgreSQL - required)
# ============================================
# db/setup.rb connects exclusively via PG.connect(DATABASE_URL) - there
# is no SQLite runtime code path. SQLite is only used by some local
# migration-tooling scripts, never by the running application.
DATABASE_URL=postgresql://user:password@localhost:5432/meme_explorer_dev

# DATABASE_TYPE/DATABASE_PATH/DB_TYPE (see config/schema.rb, marked
# "legacy" there) are not read by db/setup.rb - don't set them expecting
# them to switch database engines.

# ============================================
# Redis (Session & Cache)
# ============================================
REDIS_URL=rediss://username:password@your-redis-host:6379

# ============================================
# Advertisement Configuration (Google AdSense)
# ============================================
# Get your AdSense Client ID from https://www.google.com/adsense
# Site Verification Code (get from Google Search Console)
GOOGLE_SITE_VERIFICATION=your-verification-code-here
# GOOGLE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# GOOGLE_AD_SLOT_SQUARE=XXXXXXXXXX
# GOOGLE_AD_SLOT_BANNER=XXXXXXXXXX
# GOOGLE_AD_SLOT_NATIVE=XXXXXXXXXX

# Ad Frequency (show ad every N memes)
# Recommended: 12 for good UX, 8-10 for more revenue
AD_FREQUENCY=12

# Disable all ads (for testing or premium users)
# DISABLE_ADS=false

# ============================================
# Reddit OAuth2 (Get from https://www.reddit.com/prefs/apps)
# ============================================
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REDIRECT_URI=http://localhost:3000/auth/reddit/callback
# Reddit API User-Agent — must be a real Reddit username per Reddit ToS
REDDIT_USERNAME=your_reddit_bot_account_username

# For production:
# REDDIT_REDIRECT_URI=https://meme-explorer.onrender.com/auth/reddit/callback

# ============================================
# Sentry Error Tracking
# Get SENTRY_DSN from https://sentry.io/account/
# ============================================
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# For development:
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ============================================
# Puma Web Server
# ============================================
# WEB_CONCURRENCY must stay 0 (single worker) - config/puma.rb's own
# comments explain why: the meme pool lives in shared in-process memory
# (MEME_CACHE), which only works with exactly one worker process. Setting
# this above 0 enables Puma cluster mode and will break that assumption.
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=32

# ============================================
# Feature Flags (documented in config/schema.rb as OPTIONAL, but not
# currently read anywhere in lib/ or routes/ - listed here for parity
# with that file, not because setting them changes current behavior)
# ============================================
# PHASE_3_ENABLED=true
# ENABLE_SPACED_REPETITION=true
# ENABLE_PERSONALIZATION=true

# The `stripe` gem is in the Gemfile, but there is currently no Stripe
# integration code anywhere in lib/ or routes/ (no payment routes, no
# webhook handler). Don't put real Stripe keys here for a feature that
# doesn't exist yet - uncomment and fill these in only once real
# integration code lands.
# STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
# STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
# STRIPE_PRICE_ID_MONTHLY=price_YOUR_MONTHLY_PRICE_ID
# STRIPE_PRICE_ID_YEARLY=price_YOUR_YEARLY_PRICE_ID
